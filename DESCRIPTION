Package: bfiWholegrain
Type: Research Compendium
Title: Investigation of Biomarkers for Whole Grain Cereal Intake
Version: 1.0.0
Authors@R: c(
    person("Tu", "Hu", role = c("aut", "cre"), 
           email = "tu@example.com"),
    person("Gözde", "Gürdeniz", role = "aut"),
    person("Lars Ove", "Dragsted", role = "aut")
